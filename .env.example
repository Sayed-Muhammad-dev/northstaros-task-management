# Local SQLite database. Keep private runtime records outside public/dist.
DATABASE_FILE=.app-data/northstar.sqlite
# Development: Vite uses 5345 and proxies /api to 5346.
API_PORT=5346
APP_ORIGIN=http://127.0.0.1:5345
# Production: set APP_ORIGIN to the actual HTTPS browser origin.
# Node server hosts dist and APIs together; durable disk is required.
# A static-only Vercel build does not provide this application's backend.
