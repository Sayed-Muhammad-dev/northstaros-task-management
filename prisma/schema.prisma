datasource db {
  provider = "postgresql"
}
model schema_versions {
  version Int @id
  applied_at String @db.Text
}
model users {
  id String @id @db.Text
  name String @db.Text
  email String @unique @db.Text
  password_hash String @db.Text
  team String @default("") @db.Text
  password_version Int @default(1)
  created_at String @db.Text
  memberships memberships[]
  sessions sessions[]
  acceptedInvitations invitations[] @relation("accepted")
  createdInvitations invitations[] @relation("creator")
}
model workspaces {
  id String @id @db.Text
  name String @db.Text
  created_at String @db.Text
  memberships memberships[]
  state workspace_state?
  sessions sessions[]
  invitations invitations[]
}
model memberships {
  workspace_id String @db.Text
  user_id String @db.Text
  role String @db.Text
  created_at String @db.Text
  workspace workspaces @relation(fields:[workspace_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
  user users @relation(fields:[user_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
  @@id([workspace_id,user_id])
}
model workspace_state {
  workspace_id String @id @db.Text
  revision Int
  state String @db.Text
  updated_at String @db.Text
  workspace workspaces @relation(fields:[workspace_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
}
model sessions {
  token_hash String @id @db.Text
  user_id String @db.Text
  workspace_id String @db.Text
  password_version Int
  expires_at String @db.Text
  created_at String @db.Text
  user users @relation(fields:[user_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
  workspace workspaces @relation(fields:[workspace_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
  @@index([user_id],map:"sessions_user")
}
model invitations {
  id String @id @db.Text
  workspace_id String @db.Text
  email String @db.Text
  role String @db.Text
  token_hash String @unique @db.Text
  expires_at String @db.Text
  accepted_at String? @db.Text
  accepted_user_id String? @db.Text
  creator_id String @db.Text
  created_at String @db.Text
  workspace workspaces @relation(fields:[workspace_id],references:[id],onDelete:Cascade,onUpdate:NoAction)
  acceptedUser users? @relation("accepted",fields:[accepted_user_id],references:[id],onDelete:NoAction,onUpdate:NoAction)
  creator users @relation("creator",fields:[creator_id],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([workspace_id],map:"invitations_workspace")
}
model rate_guards {
  key_hash String @id @db.Text
  window_start BigInt
  hits Int
}
